<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
  	<meta name='viewport' content='width=device-width'>

    <title>{{title}}</title>
    <meta name='description' content="{{description }}">
    <meta name="theme-color" content="#ffffff"/>

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json" />

    <link href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" rel="stylesheet">
    <link href="/assets/styles/tailwind.css?v={{ buildVersion }}" rel="stylesheet" />
    <link href="/assets/styles/index.css?v={{ buildVersion }}" rel="stylesheet" />
    <script>
      const isDarkMode = () => localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
      // Set the theme before the body renders to avoid a flash; the toggle icon is set at the end of the body
      if (isDarkMode()) {
        document.documentElement.classList.add('dark')
      } else {
        document.documentElement.classList.remove('dark')
      }
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J096MER4MD"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-J096MER4MD');
    </script>

  </head>

  <body class="dark:text-white dark:bg-black">
    {{ content }}

  <script>
    if (isDarkMode()) {
      document.getElementById("toggleDarkMode").classList.add('md-dark');
      document.getElementById("toggleDarkMode").classList.remove('md-light');
    }

    document.getElementById("toggleDarkMode").addEventListener("click", function() {
      if (isDarkMode()) {
        localStorage.theme = 'light'
        document.documentElement.classList.remove('dark')
        document.getElementById("toggleDarkMode").classList.remove('md-dark');
        document.getElementById("toggleDarkMode").classList.add('md-light');
      } else {
        localStorage.theme = 'dark'
        document.documentElement.classList.add('dark')
        document.getElementById("toggleDarkMode").classList.add('md-dark');
        document.getElementById("toggleDarkMode").classList.remove('md-light');
      }
    });
  </script>
  </body>
</html>
