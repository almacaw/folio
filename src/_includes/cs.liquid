---
layout: main
---

{% include "nav.liquid" %}
<div class="pt-16">
  <h1 class="text-3xl lg:text-7xl font-semibold leading-tight">
  {{ title }}
  </h1>
</div>
<div class="nav text-md pt-8">
  {% if date %}
    <span>{{ date | date: "%Y-%m-%d" }}</span> &mdash;
  {% endif %}
    <span>{{ content | readTime }} min read</span>


</div>

<div class="py-8 text-xl">
  {% image cover, cover-alt, cover-caption, cover-class %}
</div>


<div class="prose dark:prose-invert text-l xl:text-xl leading-6 xl:leading-9 font-book py-8 xl:py-16">

  {{ content }}
  <a href="/">Back to case studies ⤴</a>
</div>
